static func has(sprite_name: String) -> bool:
	return SPR.has(sprite_name)

static func base_scale(sprite_name: String) -> float:
	return float(SPR[sprite_name][2])

## Cria um Sprite2D cuja origem (0,0) fica na base central (pes). 'extra' multiplica a escala base.
static func make(sprite_name: String, extra: float = 1.0) -> Sprite2D:
	var d: Array = SPR[sprite_name]
	var tex := AtlasTexture.new()
	tex.atlas = load(d[0])
	tex.region = d[1]
	var s := Sprite2D.new()
	s.texture = tex
	s.centered = false
	s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	s.offset = Vector2(-d[1].size.x * 0.5, -d[1].size.y)
	s.scale = Vector2.ONE * float(d[2]) * extra
	return s
